# proxy replacemet config
KEYWORD=test-keyword
REPLACEMENT=[REDACTED]

# addresses
LISTEN_ADDR=:8443
UPSTREAM_URL=https://upstream:8443

# CA that signed the upstream's certificate.
CA_CERT_FILE=/certs/ca.crt

# Keypair presented to clients.
TLS_CERT_FILE=/certs/proxy.crt
TLS_KEY_FILE=/certs/proxy.key

LOG_LEVEL=info
